<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
  <persistence-unit name="LTWebPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <class>ute.fit.entity.AccountEntity</class>
    <class>ute.fit.entity.BaristaEntity</class>
    <class>ute.fit.entity.BeverageEntity</class>
    <class>ute.fit.entity.CustomerEntity</class>
    <class>ute.fit.entity.DiscountEntity</class>
    <class>ute.fit.entity.NotificationEntity</class>
    <class>ute.fit.entity.OrderEntity</class>
    <class>ute.fit.entity.OrderItemEntity</class>
    <class>ute.fit.entity.PaymentEntity</class>
    <class>ute.fit.entity.PersonEntity</class>
    <class>ute.fit.entity.StaffEntity</class>
    <class>ute.fit.entity.ToppingEntity</class>

    <properties>
        <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />

        <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/MilkTeaKiosk" />
        <property name="jakarta.persistence.jdbc.user" value="postgres" />
        <property name="jakarta.persistence.jdbc.password" value="your_password" />
        
        <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />

        <property name="hibernate.hbm2ddl.auto" value="update" />
        
        <property name="hibernate.show_sql" value="true" />
        <property name="hibernate.format_sql" value="true" />
        
        <property name="hibernate.temp.use_jdbc_metadata_defaults" value="false" />
    </properties>
  </persistence-unit>
</persistence>